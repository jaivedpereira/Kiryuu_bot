# Configuracoes do bot Kiryuu
BOT_NAME=Kiryuu
BOT_PREFIX=!

# Numero do dono (opcional), so digitos com DDI. Ex: 5582987554870
BOT_OWNER=

# === LOGIN POR CODIGO DE PAREAMENTO (recomendado) ===
# Coloque AQUI o numero do WhatsApp que sera o bot, somente digitos,
# com codigo do pais (55) e DDD. SEM +, espacos ou tracos.
# Exemplo para um numero de Alagoas (82): 5582987554870
# Quando preenchido, o bot mostra um codigo para voce digitar no WhatsApp
# em vez de escanear o QR code.
BOT_NUMBER=

# Forca o uso de codigo de pareamento mesmo sem BOT_NUMBER (deixe vazio normalmente)
USE_PAIRING_CODE=
